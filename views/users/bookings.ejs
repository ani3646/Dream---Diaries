<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <div class="row mb-5">

    <div class="col-md-4 mb-3">

        <div class="card border-0 shadow-sm rounded-4 text-center p-4">

            <i class="fa-solid fa-calendar-check fs-1 text-success mb-3"></i>

            <h2 class="fw-bold">
                <%= bookings.length %>
            </h2>

            <p class="text-muted mb-0">
                Total Bookings
            </p>

        </div>

    </div>

    <div class="col-md-4 mb-3">

        <div class="card border-0 shadow-sm rounded-4 text-center p-4">

            <i class="fa-solid fa-bed fs-1 text-danger mb-3"></i>

            <h2 class="fw-bold">
                <%= bookings.filter(b => b.status === "Confirmed").length %>
            </h2>

            <p class="text-muted mb-0">
                Active Trips
            </p>

        </div>

    </div>

    <div class="col-md-4 mb-3">

        <div class="card border-0 shadow-sm rounded-4 text-center p-4">

            <i class="fa-solid fa-wallet fs-1 text-warning mb-3"></i>

            <h2 class="fw-bold">
                ₹ <%= bookings.reduce((sum, b) => sum + b.totalPrice, 0).toLocaleString("en-IN") %>
            </h2>

            <p class="text-muted mb-0">
                Total Spent
            </p>

        </div>

    </div>

</div>

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            <i class="fa-solid fa-calendar-check text-success"></i>
            My Bookings
        </h1>

        <p class="text-muted">
            Manage all your trips in one place.
        </p>

    </div>

    <% if(bookings.length === 0){ %>

<div class="text-center py-5">

    <i class="fa-solid fa-calendar-xmark fa-5x text-secondary mb-4"></i>

    <h3>No Bookings Yet</h3>

    <p class="text-muted">

        Start exploring amazing stays.

    </p>

    <a href="/listings" class="btn btn-danger">

        Explore Listings

    </a>

</div>

<% } else { %>

        <div class="row">

        <% bookings.forEach((booking)=>{ %>

           <div class="card booking-card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">

    <div class="row g-0">

        <!-- Listing Image -->
        <div class="col-md-4">

            <img
                src="<%= booking.listing.image.url %>"
                class="img-fluid h-100 w-100"
                style="object-fit:cover; min-height:260px;">

        </div>

        <!-- Booking Details -->
        <div class="col-md-8">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between">

                    <div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">

    <h4 class="fw-bold mb-0">
        <%= booking.listing.title %>
    </h4>

    <span class="badge bg-light text-dark border">
        #<%= booking._id.toString().slice(-6) %>
    </span>

</div>

                        <p class="text-muted mb-3">
                            <i class="fa-solid fa-location-dot text-danger"></i>
                            <%= booking.listing.location %>,
                            <%= booking.listing.country %>
                        </p>

                        <p class="small text-muted mb-3">

    <i class="fa-solid fa-user"></i>

    Hosted by

    <strong>
        <%= booking.listing.owner?.username || "Host" %>
    </strong>

</p>

                    </div>

                    <span class="badge rounded-pill px-3 py-2
<%= booking.status === 'Confirmed'
    ? 'bg-success'
    : booking.status === 'Cancelled'
    ? 'bg-danger'
    : 'bg-warning text-dark' %>">

    <%= booking.status %>

</span>

                </div>

                <hr>

                <div class="row">

                    <div class="col-md-3 mb-3">

                        <small class="text-muted">
                            Check In
                        </small>

                        <h6>

                            <i class="fa-solid fa-calendar-days text-primary"></i>

                            <%= booking.checkIn.toDateString() %>

                        </h6>

                    </div>

                    <div class="col-md-3 mb-3">

                        <small class="text-muted">
                            Check Out
                        </small>

                        <h6>

                            <i class="fa-solid fa-calendar-days text-danger"></i>

                            <%= booking.checkOut.toDateString() %>

                        </h6>

                    </div>

                    <div class="col-md-2 mb-3">

                        <small class="text-muted">
                            Guests
                        </small>

                        <h6>

                            <i class="fa-solid fa-users"></i>

                            <%= booking.guests %>

                        </h6>

                    </div>

                    <div class="col-md-2 mb-3">

                        <small class="text-muted">
                            Nights
                        </small>

                        <h6>

                            <%= booking.totalNights %>

                        </h6>

                    </div>

                    <div class="col-md-2 mb-3">

                        <small class="text-muted">
                            Total
                        </small>

                        <h5 class="text-danger fw-bold">

                            ₹ <%= booking.totalPrice.toLocaleString("en-IN") %>

                        </h5>

                    </div>

                </div>

                <hr>

                <div class="d-flex gap-2">

                    <a
                        href="/listings/<%= booking.listing._id %>"
                        class="btn btn-dark">

                        View Listing

                    </a>

                    <form
                        action="/bookings/<%= booking._id %>?_method=DELETE"
                        method="POST">

                        <button class="btn btn-outline-danger">

                            Cancel Booking

                        </button>

                        <a
    href="/bookings/<%= booking._id %>/invoice"
    class="btn btn-primary rounded-pill px-4">

    <i class="fa-solid fa-file-pdf"></i>

    Invoice

</a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

        <% }) %>

        </div>

    <% } %>

</div>