<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <h2 class="mb-4 fw-bold">
        Welcome,
        <%= user.username %> 👋
    </h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow text-center p-4">
                <h1>🏠</h1>
                <h3><%= myListings.length %></h3>
                <p>My Listings</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow text-center p-4">
                <h1>📅</h1>
                <h3><%= myBookings.length %></h3>
                <p>My Bookings</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow text-center p-4">
                <h1>❤️</h1>
                <h3><%= user.wishlist.length %></h3>
                <p>Wishlist</p>
            </div>
        </div>

    </div>

    <hr class="my-5">

    <h3>Recent Bookings</h3>

    <% if(myBookings.length === 0){ %>

        <p class="text-muted">
            No bookings yet.
        </p>

    <% } else { %>

        <% myBookings.forEach((booking)=>{ %>

            <div class="card mb-3 shadow-sm">

                <div class="card-body">

                    <h5>
                        <%= booking.listing.title %>
                    </h5>

                    <p>
                        <%= booking.listing.location %>,
                        <%= booking.listing.country %>
                    </p>

                    <span class="badge bg-success">
                        <%= booking.status %>
                    </span>

                </div>

            </div>

        <% }) %>

    <% } %>

</div>