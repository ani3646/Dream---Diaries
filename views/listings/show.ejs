                    <script>

const bookedDates = <%- JSON.stringify(bookedDates) %>;

const checkIn = document.getElementById("checkIn");
const checkOut = document.getElementById("checkOut");

// Today se pehle date select nahi hogi
const today = new Date().toISOString().split("T")[0];
checkIn.min = today;
checkOut.min = today;

// Check In change hone par
checkIn.addEventListener("change", () => {

    checkOut.min = checkIn.value;

    const selected = new Date(checkIn.value);

    for (let booking of bookedDates) {

        const start = new Date(booking.checkIn);
        const end = new Date(booking.checkOut);

        if (selected >= start && selected < end) {

            alert("This date is already booked.");

            checkIn.value = "";

            return;
        }
    }
});

// Check Out change hone par
checkOut.addEventListener("change", () => {

    const selected = new Date(checkOut.value);

    for (let booking of bookedDates) {

        const start = new Date(booking.checkIn);
        const end = new Date(booking.checkOut);

        if (selected > start && selected <= end) {

            alert("This date is already booked.");

            checkOut.value = "";

            return;
        }
    }
});

</script>

